{
	"compatibility_date": "2026-04-12",
	"compatibility_flags": ["global_fetch_strictly_public"],
	"name": "psychedelicare-eu",
	"main": "@astrojs/cloudflare/entrypoints/server",
	"workers_dev": true,
	"preview_urls": true,
	"routes": [
		{
			"pattern": "www.psychedelicare.eu",
			"custom_domain": true
		}
	],
	"assets": {
		"directory": "./dist",
		"binding": "ASSETS"
	},
	"vars": {
		"MAILCHIMP_SERVER_PREFIX": "us21",
		"MAILCHIMP_LIST_ID": ""
	},
	"observability": {
		"enabled": true
	}
}