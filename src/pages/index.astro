---
import PageScaffold from "../components/PageScaffold.astro";
import { homePage } from "../data/pageScaffolds";
import BaseLayout from "../layouts/BaseLayout.astro";

if (!homePage) {
  throw new Error("Home page scaffold is missing.");
}
---

<BaseLayout title="PsychedeliCare | Home" description={homePage.summary}>
  <PageScaffold page={homePage} />
</BaseLayout>
