---
import { AstroError } from "astro/errors";
import { render } from "astro:content";

import NewsList from "../components/NewsList.astro";
import PageLayout from "../layouts/PageLayout.astro";
import { getNewsPosts, getPageBySlug } from "../lib/content";
import { defaultLocale } from "../lib/i18n";

const entry = await getPageBySlug(defaultLocale, "");

if (!entry) {
  throw new AstroError("Default homepage content is missing.");
}

const { Content, headings } = await render(entry);
const relatedEntries =
  entry.data.pageType === "news-hub"
    ? await getNewsPosts(defaultLocale, { limit: 6 })
    : entry.data.pageType === "section" && entry.data.slug.startsWith("news/")
      ? await getNewsPosts(defaultLocale, { section: entry.data.slug })
      : [];
---

<PageLayout entry={entry} headings={headings}>
  <Content />
  {relatedEntries.length > 0 && <NewsList entries={relatedEntries} />}
</PageLayout>
