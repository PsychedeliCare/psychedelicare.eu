---
import PageScaffold from "../components/PageScaffold.astro";
import { pages, type ScaffoldPage } from "../data/pageScaffolds";
import BaseLayout from "../layouts/BaseLayout.astro";

export function getStaticPaths() {
  return pages
    .filter((page) => page.slug !== "")
    .map((page) => ({
      params: { slug: page.slug },
      props: { page },
    }));
}

type Props = {
  page: ScaffoldPage;
};

const { page } = Astro.props;
---

<BaseLayout title={`PsychedeliCare | ${page.title}`} description={page.summary}>
  <PageScaffold page={page} />
</BaseLayout>
