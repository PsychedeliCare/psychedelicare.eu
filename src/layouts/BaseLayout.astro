---
import "../styles/global.css";
import "flag-icons/css/flag-icons.min.css";
import IconBrandGithub from "../../node_modules/@tabler/icons/icons/outline/brand-github.svg?raw";
import IconBook from "../../node_modules/@tabler/icons/icons/outline/book-2.svg?raw";
import IconBriefcase from "../../node_modules/@tabler/icons/icons/outline/briefcase.svg?raw";
import IconBuildingCommunity from "../../node_modules/@tabler/icons/icons/outline/building-community.svg?raw";
import IconCalendar from "../../node_modules/@tabler/icons/icons/outline/calendar-event.svg?raw";
import IconChartBar from "../../node_modules/@tabler/icons/icons/outline/chart-bar.svg?raw";
import IconFlask from "../../node_modules/@tabler/icons/icons/outline/flask.svg?raw";
import IconHeartHandshake from "../../node_modules/@tabler/icons/icons/outline/heart-handshake.svg?raw";
import IconHelpCircle from "../../node_modules/@tabler/icons/icons/outline/help-circle.svg?raw";
import IconMail from "../../node_modules/@tabler/icons/icons/outline/mail.svg?raw";
import IconMapPin from "../../node_modules/@tabler/icons/icons/outline/map-pin.svg?raw";
import IconMicrophone from "../../node_modules/@tabler/icons/icons/outline/microphone.svg?raw";
import IconNews from "../../node_modules/@tabler/icons/icons/outline/news.svg?raw";
import IconPhotoSpark from "../../node_modules/@tabler/icons/icons/outline/photo-spark.svg?raw";
import IconReportAnalytics from "../../node_modules/@tabler/icons/icons/outline/report-analytics.svg?raw";
import IconRocket from "../../node_modules/@tabler/icons/icons/outline/rocket.svg?raw";
import IconSchool from "../../node_modules/@tabler/icons/icons/outline/school.svg?raw";
import IconShieldCheck from "../../node_modules/@tabler/icons/icons/outline/shield-check.svg?raw";
import IconSparkles from "../../node_modules/@tabler/icons/icons/outline/sparkles.svg?raw";
import IconSpeakerphone from "../../node_modules/@tabler/icons/icons/outline/speakerphone.svg?raw";
import IconUsersGroup from "../../node_modules/@tabler/icons/icons/outline/users-group.svg?raw";
import IconWorldHeart from "../../node_modules/@tabler/icons/icons/outline/world-heart.svg?raw";

import { SEO } from "astro-seo";

import SocialLinks from "../components/SocialLinks.astro";
import { defaultLocale, localizePath, normalizeLocale } from "../lib/i18n";
import { getImagePath } from "../lib/openGraphImage";
import { getLocaleFlagClass } from "../lib/localeFlags";
import { buildNavigationContext, isNavItemActive } from "../lib/siteNavigation";
import { getUiCopy } from "../lib/uiCopy";

type Props = {
  title: string;
  description?: string;
  locale?: string;
  slug?: string;
  translationGroup?: string;
};

const {
  title,
  description = "PsychedeliCare",
  locale = defaultLocale,
  slug = "",
  translationGroup,
} = Astro.props;

const currentLocale = normalizeLocale(locale);
const navigation = await buildNavigationContext(
  currentLocale,
  slug,
  translationGroup,
);
const isHome = slug === "";
const uiCopy = getUiCopy(currentLocale);
const homeHref = navigation.primaryItems[0]?.href ?? localizePath(currentLocale, "");
const mediaHref = localizePath(currentLocale, "resources/media-press-kit");
const showTranslationPreviewBanner = currentLocale !== defaultLocale;
const legalItem = navigation.utilityItems.find((item) => item.slug === "legal");
const privacyItem = navigation.utilityItems.find((item) => item.slug === "privacy-policy");
const legalHref = legalItem?.href ?? localizePath(currentLocale, "legal");
const legalLabel = legalItem?.label ?? "Legal";
const privacyHref = privacyItem?.href ?? localizePath(currentLocale, "privacy-policy");
const privacyLabel = privacyItem?.label ?? "Privacy Policy";
const navIcons: Record<string, string> = {
  book: IconBook,
  briefcase: IconBriefcase,
  calendar: IconCalendar,
  community: IconBuildingCommunity,
  education: IconSchool,
  faq: IconHelpCircle,
  impact: IconChartBar,
  mail: IconMail,
  map: IconMapPin,
  media: IconPhotoSpark,
  microphone: IconMicrophone,
  news: IconNews,
  partnership: IconHeartHandshake,
  patients: IconUsersGroup,
  report: IconReportAnalytics,
  rocket: IconRocket,
  safety: IconShieldCheck,
  science: IconFlask,
  speaker: IconSpeakerphone,
  toolkit: IconBriefcase,
  world: IconWorldHeart,
};
const getNavIcon = (icon?: string) => navIcons[icon ?? ""] ?? IconSparkles;
const { url, site } = Astro;
const openGraphImageUrl = getImagePath({ url, site });
---

<!doctype html>
<html lang={currentLocale}>
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Jost:wght@400;500;600;700;800;900&display=swap"
      rel="stylesheet"
    />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <title>{title}</title>

    <SEO
      description={description}
      canonical={url.href}
      openGraph={{
        basic: {
          title,
          type: "website",
          image: openGraphImageUrl,
          url: url.href,
        },
        optional: {
          description,
        },
      }}
    />
  </head>
  <body>
    <header class="site-header">
      <div class="container px-4">
        <div class="site-header__bar">
          <a class="brand" href={navigation.primaryItems[0]?.href ?? "/"}>
            <img
              class="brand__logo"
              src="/assets/psychedelicareeu-logo.svg"
              alt="PsychedeliCare"
            />
          </a>

          <nav class="site-nav site-nav--desktop" aria-label="Primary">
            <ul class="site-nav__list">
              {
                navigation.primaryItems.map((item) => {
                  const isActive = isNavItemActive(slug, item.slug);

                  return (
                    <li
                      class:list={[
                        "site-nav__item",
                        item.hidden && "site-nav__item--hidden",
                      ]}
                    >
                      {
                        item.children.length > 0 ? (
                          <details
                            class="nav-disclosure"
                            data-group="header-popover"
                            data-hover-menu
                          >
                            <summary
                              class:list={[
                                "nav-summary",
                                isActive && "nav-summary--active",
                              ]}
                            >
                              <span>{item.label}</span>
                              <span class="nav-caret" aria-hidden="true"></span>
                            </summary>

                            <div class="nav-disclosure__panel">
                              <a
                                class:list={[
                                  "nav-disclosure__lead",
                                  isActive && "nav-disclosure__lead--active",
                                ]}
                                href={item.href}
                              >
                                <span class="nav-disclosure__lead-copy">
                                  <span>{item.label}</span>
                                  <span>{item.description ?? uiCopy.browseSection}</span>
                                </span>
                                <span class="nav-disclosure__lead-arrow" aria-hidden="true"></span>
                              </a>

                              <ul class="nav-disclosure__links">
                                {item.children.map((child) => (
                                  <li>
                                    <a
                                      class="nav-disclosure__item"
                                      href={child.href}
                                      aria-current={
                                        isNavItemActive(slug, child.slug) ? "page" : undefined
                                      }
                                    >
                                      <span
                                        class="nav-disclosure__icon nav-disclosure__icon--item"
                                        set:html={getNavIcon(child.icon)}
                                      ></span>
                                      <span class="nav-disclosure__item-copy">
                                        <span class="nav-disclosure__item-title">{child.label}</span>
                                        {child.description && (
                                          <span class="nav-disclosure__item-description">
                                            {child.description}
                                          </span>
                                        )}
                                      </span>
                                    </a>
                                  </li>
                                ))}
                              </ul>
                            </div>
                          </details>
                        ) : (
                          <a
                            class:list={[
                              "nav-link",
                              isActive && "nav-link--active",
                            ]}
                            href={item.href}
                            aria-current={isActive ? "page" : undefined}
                          >
                            {item.label}
                          </a>
                        )
                      }
                    </li>
                  );
                })
              }
            </ul>
          </nav>

          <div class="site-header__actions">
            <details class="language-switcher" data-group="header-popover">
              <summary
                class="locale-chip"
                aria-label={`${uiCopy.languages}: ${navigation.currentLanguage.nativeLabel}`}
              >
                <span
                  class:list={["locale-flag", getLocaleFlagClass(navigation.currentLanguage.locale)]}
                  aria-hidden="true"
                ></span>
                <span class="locale-chip__code">
                  {navigation.currentLanguage.code}
                </span>
                <span class="nav-caret" aria-hidden="true"></span>
              </summary>

              <div class="language-switcher__panel">
                <p class="language-switcher__label">{uiCopy.languages}</p>
                <ul>
                  {
                    navigation.languageOptions.map((option) => (
                      <li>
                        <a href={option.href} aria-current={option.current ? "page" : undefined}>
                          <span
                            class:list={["locale-flag", getLocaleFlagClass(option.locale)]}
                            aria-hidden="true"
                          ></span>
                          <span class="language-switcher__label-text">{option.nativeLabel}</span>
                        </a>
                      </li>
                    ))
                  }
                </ul>
              </div>
            </details>

            <a class="button-primary" href={navigation.donateHref}>{uiCopy.support}</a>

            <details class="mobile-menu" data-group="header-popover" data-drawer-menu>
              <summary class="mobile-menu__toggle">
                <span class="mobile-menu__icon" aria-hidden="true">
                  <span></span>
                  <span></span>
                  <span></span>
                </span>
                <span class="mobile-menu__label">{uiCopy.menu}</span>
              </summary>

              <div class="mobile-menu__backdrop" aria-hidden="true"></div>

              <div
                class="mobile-menu__panel"
                role="dialog"
                aria-modal="true"
                aria-label={uiCopy.menu}
              >
                <div class="mobile-menu__header">
                  <p class="mobile-menu__title">{uiCopy.menu}</p>
                </div>

                <div class="mobile-menu__content">
                  <a class="button-primary mobile-menu__cta" href={navigation.donateHref}>
                    {uiCopy.support}
                  </a>

                  <nav aria-label="Mobile primary">
                  <ul class="mobile-menu__sections">
                    {
                      navigation.primaryItems.map((item) => (
                        <li class:list={[item.hidden && "mobile-menu__section--hidden"]}>
                          {
                            item.children.length > 0 ? (
                              <details class="mobile-menu__group" data-group="mobile-subnav">
                                <summary class="mobile-menu__group-summary">
                                  <span>{item.label}</span>
                                  <span class="nav-caret mobile-menu__caret" aria-hidden="true"></span>
                                </summary>
                                <div class="mobile-menu__group-body">
                                  <a
                                    class:list={[
                                      "mobile-menu__lead",
                                      isNavItemActive(slug, item.slug) && "mobile-menu__lead--active",
                                    ]}
                                    href={item.href}
                                  >
                                    <span
                                      class="nav-disclosure__icon"
                                      set:html={getNavIcon(item.icon)}
                                    ></span>
                                    <span class="mobile-menu__item-copy">
                                      <span>{uiCopy.browseItemPrefix} {item.label}</span>
                                      {item.description && <span>{item.description}</span>}
                                    </span>
                                  </a>
                                  {item.children.map((child) => (
                                    <a
                                      class="mobile-menu__item"
                                      href={child.href}
                                      aria-current={
                                        isNavItemActive(slug, child.slug) ? "page" : undefined
                                      }
                                    >
                                      <span
                                        class="nav-disclosure__icon nav-disclosure__icon--item"
                                        set:html={getNavIcon(child.icon)}
                                      ></span>
                                      <span class="mobile-menu__item-copy">
                                        <span>{child.label}</span>
                                        {child.description && <span>{child.description}</span>}
                                      </span>
                                    </a>
                                  ))}
                                </div>
                              </details>
                            ) : (
                              <a class="mobile-menu__single" href={item.href}>{item.label}</a>
                            )
                          }
                        </li>
                      ))
                    }
                  </ul>
                </nav>

                <div class="mobile-menu__languages">
                  <p>{uiCopy.languages}</p>
                  <div>
                    {
                      navigation.languageOptions.map((option) => (
                        <a href={option.href} aria-current={option.current ? "page" : undefined}>
                          <span
                            class:list={["locale-flag", getLocaleFlagClass(option.locale)]}
                            aria-hidden="true"
                          ></span>
                          <span class="mobile-menu__lang-name">{option.nativeLabel}</span>
                        </a>
                      ))
                    }
                  </div>
                </div>

                <div class="mobile-menu__legal">
                  {
                    navigation.utilityItems.map((item) => (
                      <a href={item.href}>{item.label}</a>
                    ))
                  }
                </div>
                </div>
              </div>
            </details>
          </div>
        </div>
      </div>
    </header>

    {
      showTranslationPreviewBanner && (
        <aside class="translation-preview-banner" aria-label={uiCopy.translationPreviewLabel}>
          <div class="container px-4 translation-preview-banner__inner">
            <p class="translation-preview-banner__copy">
              <strong>{uiCopy.translationPreviewLabel}</strong>
              <span>{uiCopy.translationPreviewBody}</span>
            </p>
            <a
              class="translation-preview-banner__cta"
              href="https://github.com/psychedelicare/psychedelicare.eu"
              target="_blank"
              rel="noopener noreferrer"
            >
              <span class="translation-preview-banner__icon" set:html={IconBrandGithub}></span>
              <span>{uiCopy.contribute}</span>
            </a>
          </div>
        </aside>
      )
    }

    <main class="content-shell">
      <slot />
    </main>

    {
      isHome && (
        <div class="footer-illustration">
          <img
            src="/assets/illustrations/lets-care-together.png"
            alt="Let's Care Together illustration showing a healthcare professional supporting a person in a calm, hopeful setting"
            loading="lazy"
            width="1369"
            height="1168"
          />
        </div>
      )
    }

    <footer class="site-footer">
      <img
        class="site-footer__bg-logo"
        src="/assets/background-logo.svg"
        alt=""
        aria-hidden="true"
        loading="lazy"
        decoding="async"
      />

      <div class="container px-4 site-footer__inner">
        <div class="site-footer__nav-row">
          <nav class="site-footer__links" aria-label={uiCopy.footerLinks}>
            <img
              class="site-footer__org"
              src="/assets/psychedelicare_eu_logo_white.png"
              alt="PsychedeliCare e.V."
              width="1920"
              height="645"
              loading="lazy"
              decoding="async"
            />
            <a href="mailto:info@psychedelicare.eu">{uiCopy.footerContact}</a>
            <a href={mediaHref}>{uiCopy.footerMedia}</a>
            <a href={legalHref}>{legalLabel}</a>
            <a href={privacyHref}>{privacyLabel}</a>
          </nav>

          <SocialLinks showLabels={false} />
        </div>
      </div>
    </footer>

    <script is:inline>
      (() => {
        const closingTimers = new WeakMap();
        const reduceMotionQuery = window.matchMedia("(prefers-reduced-motion: reduce)");

        const isAnimatedDetail = (detail) =>
          detail.classList.contains("nav-disclosure") ||
          detail.classList.contains("mobile-menu");

        const setMobileMenuOpen = (open) => {
          document.body.classList.toggle("mobile-menu-open", open);
        };

        const closeDetail = (detail, animated = false) => {
          if (!detail.open || detail.dataset.closing === "true") return;

          const shouldAnimate =
            animated && !reduceMotionQuery.matches && isAnimatedDetail(detail);

          if (detail.classList.contains("mobile-menu")) {
            setMobileMenuOpen(false);
          }

          if (!shouldAnimate) {
            detail.open = false;
            delete detail.dataset.closing;
            return;
          }

          detail.dataset.closing = "true";
          const closeDelay = detail.classList.contains("mobile-menu") ? 320 : 190;
          const timer = window.setTimeout(() => {
            detail.open = false;
            delete detail.dataset.closing;
            closingTimers.delete(detail);
          }, closeDelay);
          closingTimers.set(detail, timer);
        };

        const openDetail = (detail) => {
          const timer = closingTimers.get(detail);
          if (timer) {
            window.clearTimeout(timer);
            closingTimers.delete(detail);
          }
          delete detail.dataset.closing;

          const group = detail.dataset.group;
          if (group) {
            document.querySelectorAll(`details[data-group="${group}"]`).forEach((other) => {
              if (other instanceof HTMLDetailsElement && other !== detail) {
                closeDetail(other, isAnimatedDetail(other));
              }
            });
          }

          if (detail.classList.contains("mobile-menu")) {
            setMobileMenuOpen(true);
          }

          detail.open = true;
        };

        const scheduleClose = (detail) => {
          const existingTimer = closingTimers.get(detail);
          if (existingTimer) window.clearTimeout(existingTimer);

          const timer = window.setTimeout(() => {
            closeDetail(detail, true);
          }, 110);
          closingTimers.set(detail, timer);
        };

        document.querySelectorAll("details[data-hover-menu]").forEach((menu) => {
          if (!(menu instanceof HTMLDetailsElement)) return;

          const summary = menu.querySelector("summary");
          if (!summary) return;

          menu.addEventListener("mouseenter", () => {
            openDetail(menu);
          });

          menu.addEventListener("mouseleave", () => {
            scheduleClose(menu);
          });

          menu.addEventListener("focusin", () => openDetail(menu));
          menu.addEventListener("focusout", (event) => {
            if (!menu.contains(event.relatedTarget)) scheduleClose(menu);
          });

          summary.addEventListener("click", (event) => {
            event.preventDefault();
            if (menu.open && menu.dataset.closing !== "true") {
              closeDetail(menu, true);
            } else {
              openDetail(menu);
            }
          });

          menu.addEventListener("keydown", (event) => {
            if (event.key !== "Escape") return;
            closeDetail(menu, true);
            summary.focus();
          });
        });

        document.addEventListener("toggle", (event) => {
          const target = event.target;
          if (!(target instanceof HTMLDetailsElement) || !target.open) return;
          const group = target.dataset.group;
          if (!group) return;

          document.querySelectorAll(`details[data-group="${group}"]`).forEach((detail) => {
            if (detail instanceof HTMLDetailsElement && detail !== target) {
              closeDetail(detail, isAnimatedDetail(detail));
            }
          });
        });

        document.querySelectorAll("details[data-drawer-menu]").forEach((menu) => {
          if (!(menu instanceof HTMLDetailsElement)) return;

          const summary = menu.querySelector("summary");
          const backdrop = menu.querySelector(".mobile-menu__backdrop");
          if (!summary) return;

          summary.addEventListener("click", (event) => {
            event.preventDefault();
            if (menu.open && menu.dataset.closing !== "true") {
              closeDetail(menu, true);
            } else {
              openDetail(menu);
            }
          });

          backdrop?.addEventListener("click", () => {
            closeDetail(menu, true);
            summary.focus();
          });

          menu.addEventListener("keydown", (event) => {
            if (event.key !== "Escape") return;
            closeDetail(menu, true);
            summary.focus();
          });
        });

        document.addEventListener("pointerdown", (event) => {
          document.querySelectorAll('details[data-group="header-popover"][open]').forEach((detail) => {
            if (
              detail instanceof HTMLDetailsElement &&
              !detail.contains(event.target)
            ) {
              closeDetail(detail, isAnimatedDetail(detail));
            }
          });
        });
      })();
    </script>
  </body>
</html>
