---
import { getTopLevelPages } from "../lib/content";
import { defaultLocale, localizePath, normalizeLocale } from "../lib/i18n";

type Props = {
  title: string;
  description?: string;
  locale?: string;
  slug?: string;
};

const {
  title,
  description = "PsychedeliCare",
  locale = defaultLocale,
  slug = "",
} = Astro.props;

const currentLocale = normalizeLocale(locale);
const topLevelPages = await getTopLevelPages(currentLocale);
const navPages = topLevelPages.filter((entry) => entry.data.slug !== "news");
const navItems = [
  ...navPages,
  ...topLevelPages.filter((entry) => entry.data.slug === "news"),
];
---

<!doctype html>
<html lang={currentLocale}>
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <title>{title}</title>
  </head>
  <body>
    <header class="site-header">
      <div class="shell site-header__inner">
        <a class="brand" href={localizePath(currentLocale, "")}>PsychedeliCare</a>

        <nav aria-label="Primary">
          <ul class="nav-list">
            {
              navItems.map((entry) => {
                const href = localizePath(currentLocale, entry.data.slug);
                const isActive =
                  entry.data.slug === slug ||
                  (entry.data.slug && slug.startsWith(`${entry.data.slug}/`));

                return (
                  <li>
                    <a href={href} aria-current={isActive ? "page" : undefined}>
                      {entry.data.title}
                    </a>
                  </li>
                );
              })
            }
          </ul>
        </nav>
      </div>
    </header>

    <main class="shell content-shell">
      <slot />
    </main>
  </body>
</html>

<style is:global>
  :root {
    color-scheme: light;
    --bg: #f6f2eb;
    --bg-accent: #efe6da;
    --surface: rgba(255, 255, 255, 0.88);
    --surface-strong: rgba(255, 255, 255, 0.97);
    --border: rgba(68, 42, 22, 0.14);
    --border-strong: rgba(68, 42, 22, 0.24);
    --text: #24180f;
    --muted: #6a584b;
    --accent: #65367a;
    --accent-soft: rgba(101, 54, 122, 0.1);
    --shadow: 0 18px 42px rgba(43, 24, 14, 0.08);
    font-family:
      Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont,
      "Segoe UI", sans-serif;
    background:
      radial-gradient(circle at top, rgba(118, 73, 166, 0.1), transparent 34rem),
      linear-gradient(180deg, #fbf8f4 0%, var(--bg) 100%);
    color: var(--text);
    scroll-behavior: smooth;
  }

  * {
    box-sizing: border-box;
  }

  html,
  body {
    min-height: 100%;
    margin: 0;
  }

  body {
    line-height: 1.65;
    font-size: 16px;
  }

  img {
    max-width: 100%;
    height: auto;
    display: block;
  }

  a {
    color: var(--accent);
  }

  a:hover,
  a:focus-visible {
    color: #4f2561;
  }

  p,
  ul,
  ol,
  blockquote {
    margin: 0 0 1rem;
  }

  ul,
  ol {
    padding-left: 1.3rem;
  }

  h1,
  h2,
  h3,
  h4,
  h5,
  h6 {
    margin: 0 0 0.8rem;
    line-height: 1.15;
    font-family:
      "Iowan Old Style", "Palatino Linotype", "URW Palladio L", Georgia, serif;
  }

  h1 {
    font-size: clamp(2.3rem, 5vw, 4.6rem);
  }

  h2 {
    font-size: clamp(1.7rem, 3vw, 2.7rem);
    margin-top: 2rem;
  }

  h3 {
    font-size: clamp(1.25rem, 2vw, 1.8rem);
    margin-top: 1.7rem;
  }

  h4 {
    font-size: 1.1rem;
    margin-top: 1.4rem;
  }

  blockquote {
    padding: 1rem 1.2rem;
    border-left: 4px solid var(--accent);
    background: var(--accent-soft);
    border-radius: 0.8rem;
  }

  code {
    font-family:
      "SFMono-Regular", SFMono-Regular, Consolas, "Liberation Mono", Menlo,
      monospace;
  }

  .shell {
    width: min(1100px, calc(100vw - 2rem));
    margin: 0 auto;
  }

  .content-shell {
    padding: 2rem 0 5rem;
  }

  .site-header {
    position: sticky;
    top: 0;
    z-index: 10;
    backdrop-filter: blur(16px);
    background: rgba(246, 242, 235, 0.9);
    border-bottom: 1px solid var(--border);
  }

  .site-header__inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 1rem 0;
  }

  .brand {
    color: var(--text);
    text-decoration: none;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    font-size: 1rem;
    font-weight: 800;
  }

  .nav-list {
    display: flex;
    flex-wrap: wrap;
    gap: 0.55rem;
    align-items: center;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .nav-list a {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 2.4rem;
    padding: 0.45rem 0.8rem;
    border-radius: 999px;
    color: var(--text);
    background: var(--surface);
    border: 1px solid var(--border);
    text-decoration: none;
    font-size: 0.96rem;
    transition:
      transform 120ms ease,
      background 120ms ease,
      border-color 120ms ease;
  }

  .nav-list a:hover,
  .nav-list a:focus-visible {
    background: var(--accent-soft);
    border-color: var(--border-strong);
    outline: none;
    transform: translateY(-1px);
  }

  .nav-list a[aria-current="page"] {
    background: rgba(101, 54, 122, 0.14);
    border-color: rgba(101, 54, 122, 0.34);
    color: var(--accent);
    font-weight: 700;
  }

  .page-card {
    background: linear-gradient(180deg, var(--surface-strong), var(--surface));
    border: 1px solid var(--border);
    border-radius: 1.5rem;
    box-shadow: var(--shadow);
  }

  .prose h2:first-child,
  .prose h3:first-child {
    margin-top: 0;
  }

  .eyebrow {
    margin: 0 0 0.6rem;
    color: var(--accent);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    font-size: 0.78rem;
    font-weight: 800;
  }

  @media (max-width: 720px) {
    .site-header__inner {
      align-items: flex-start;
    }

    .nav-list {
      gap: 0.45rem;
    }

    .nav-list a {
      font-size: 0.92rem;
    }
  }
</style>
