---
import "flag-icons/css/flag-icons.min.css";
import IconBook from "../../node_modules/@tabler/icons/icons/outline/book-2.svg?raw";
import IconBriefcase from "../../node_modules/@tabler/icons/icons/outline/briefcase.svg?raw";
import IconBuildingCommunity from "../../node_modules/@tabler/icons/icons/outline/building-community.svg?raw";
import IconCalendar from "../../node_modules/@tabler/icons/icons/outline/calendar-event.svg?raw";
import IconChartBar from "../../node_modules/@tabler/icons/icons/outline/chart-bar.svg?raw";
import IconFlask from "../../node_modules/@tabler/icons/icons/outline/flask.svg?raw";
import IconHeartHandshake from "../../node_modules/@tabler/icons/icons/outline/heart-handshake.svg?raw";
import IconHelpCircle from "../../node_modules/@tabler/icons/icons/outline/help-circle.svg?raw";
import IconMail from "../../node_modules/@tabler/icons/icons/outline/mail.svg?raw";
import IconMapPin from "../../node_modules/@tabler/icons/icons/outline/map-pin.svg?raw";
import IconMicrophone from "../../node_modules/@tabler/icons/icons/outline/microphone.svg?raw";
import IconNews from "../../node_modules/@tabler/icons/icons/outline/news.svg?raw";
import IconPhotoSpark from "../../node_modules/@tabler/icons/icons/outline/photo-spark.svg?raw";
import IconReportAnalytics from "../../node_modules/@tabler/icons/icons/outline/report-analytics.svg?raw";
import IconRocket from "../../node_modules/@tabler/icons/icons/outline/rocket.svg?raw";
import IconSchool from "../../node_modules/@tabler/icons/icons/outline/school.svg?raw";
import IconShieldCheck from "../../node_modules/@tabler/icons/icons/outline/shield-check.svg?raw";
import IconSparkles from "../../node_modules/@tabler/icons/icons/outline/sparkles.svg?raw";
import IconSpeakerphone from "../../node_modules/@tabler/icons/icons/outline/speakerphone.svg?raw";
import IconUsersGroup from "../../node_modules/@tabler/icons/icons/outline/users-group.svg?raw";
import IconWorldHeart from "../../node_modules/@tabler/icons/icons/outline/world-heart.svg?raw";

import { defaultLocale, normalizeLocale } from "../lib/i18n";
import { getLocaleFlagClass } from "../lib/localeFlags";
import { buildNavigationContext, isNavItemActive } from "../lib/siteNavigation";
import { getUiCopy } from "../lib/uiCopy";

type Props = {
  title: string;
  description?: string;
  locale?: string;
  slug?: string;
  translationGroup?: string;
};

const {
  title,
  description = "PsychedeliCare",
  locale = defaultLocale,
  slug = "",
  translationGroup,
} = Astro.props;

const currentLocale = normalizeLocale(locale);
const navigation = await buildNavigationContext(
  currentLocale,
  slug,
  translationGroup,
);
const isHome = slug === "";
const uiCopy = getUiCopy(currentLocale);
const navIcons: Record<string, string> = {
  book: IconBook,
  briefcase: IconBriefcase,
  calendar: IconCalendar,
  community: IconBuildingCommunity,
  education: IconSchool,
  faq: IconHelpCircle,
  impact: IconChartBar,
  mail: IconMail,
  map: IconMapPin,
  media: IconPhotoSpark,
  microphone: IconMicrophone,
  news: IconNews,
  partnership: IconHeartHandshake,
  patients: IconUsersGroup,
  report: IconReportAnalytics,
  rocket: IconRocket,
  safety: IconShieldCheck,
  science: IconFlask,
  speaker: IconSpeakerphone,
  toolkit: IconBriefcase,
  world: IconWorldHeart,
};
const getNavIcon = (icon?: string) => navIcons[icon ?? ""] ?? IconSparkles;
---

<!doctype html>
<html lang={currentLocale}>
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Jost:wght@400;500;600;700;800&display=swap"
      rel="stylesheet"
    />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <title>{title}</title>
  </head>
  <body>
    <header class="site-header">
      <div class="shell">
        <div class="site-header__bar">
          <a class="brand" href={navigation.primaryItems[0]?.href ?? "/"}>
            <img
              class="brand__logo"
              src="/assets/psychedelicareeu-logo.svg"
              alt="PsychedeliCare"
            />
          </a>

          <nav class="site-nav site-nav--desktop" aria-label="Primary">
            <ul class="site-nav__list">
              {
                navigation.primaryItems.map((item) => {
                  const isActive = isNavItemActive(slug, item.slug);

                  return (
                    <li class="site-nav__item">
                      {
                        item.children.length > 0 ? (
                          <details
                            class="nav-disclosure"
                            data-group="header-popover"
                            data-hover-menu
                          >
                            <summary
                              class:list={[
                                "nav-summary",
                                isActive && "nav-summary--active",
                              ]}
                            >
                              <span>{item.label}</span>
                              <span class="nav-caret" aria-hidden="true"></span>
                            </summary>

                            <div class="nav-disclosure__panel">
                              <a
                                class:list={[
                                  "nav-disclosure__lead",
                                  isActive && "nav-disclosure__lead--active",
                                ]}
                                href={item.href}
                              >
                                <span class="nav-disclosure__icon" set:html={getNavIcon(item.icon)}></span>
                                <span class="nav-disclosure__lead-copy">
                                  <span>{item.label}</span>
                                  <span>{item.description ?? uiCopy.browseSection}</span>
                                </span>
                              </a>

                              <ul class="nav-disclosure__links">
                                {item.children.map((child) => (
                                  <li>
                                    <a
                                      class="nav-disclosure__item"
                                      href={child.href}
                                      aria-current={
                                        isNavItemActive(slug, child.slug) ? "page" : undefined
                                      }
                                    >
                                      <span
                                        class="nav-disclosure__icon nav-disclosure__icon--item"
                                        set:html={getNavIcon(child.icon)}
                                      ></span>
                                      <span class="nav-disclosure__item-copy">
                                        <span class="nav-disclosure__item-title">{child.label}</span>
                                        {child.description && (
                                          <span class="nav-disclosure__item-description">
                                            {child.description}
                                          </span>
                                        )}
                                      </span>
                                    </a>
                                  </li>
                                ))}
                              </ul>
                            </div>
                          </details>
                        ) : (
                          <a
                            class:list={[
                              "nav-link",
                              isActive && "nav-link--active",
                            ]}
                            href={item.href}
                            aria-current={isActive ? "page" : undefined}
                          >
                            {item.label}
                          </a>
                        )
                      }
                    </li>
                  );
                })
              }
            </ul>
          </nav>

          <div class="site-header__actions">
            <details class="language-switcher" data-group="header-popover">
              <summary
                class="locale-chip"
                aria-label={`${uiCopy.languages}: ${navigation.currentLanguage.nativeLabel}`}
              >
                <span
                  class:list={["locale-flag", getLocaleFlagClass(navigation.currentLanguage.locale)]}
                  aria-hidden="true"
                ></span>
                <span class="locale-chip__code">
                  {navigation.currentLanguage.code}
                </span>
                <span class="nav-caret" aria-hidden="true"></span>
              </summary>

              <div class="language-switcher__panel">
                <p class="language-switcher__label">{uiCopy.languages}</p>
                <ul>
                  {
                    navigation.languageOptions.map((option) => (
                      <li>
                        <a href={option.href} aria-current={option.current ? "page" : undefined}>
                          <span
                            class:list={["locale-flag", getLocaleFlagClass(option.locale)]}
                            aria-hidden="true"
                          ></span>
                          <span class="language-switcher__code">{option.code}</span>
                          <span class="language-switcher__label-text">{option.nativeLabel}</span>
                        </a>
                      </li>
                    ))
                  }
                </ul>
              </div>
            </details>

            <a class="button-primary" href={navigation.donateHref}>{uiCopy.support}</a>

            <details class="mobile-menu" data-group="header-popover">
              <summary class="mobile-menu__toggle">
                <span class="mobile-menu__icon" aria-hidden="true">
                  <span></span>
                  <span></span>
                  <span></span>
                </span>
                <span class="mobile-menu__label">{uiCopy.menu}</span>
              </summary>

              <div class="mobile-menu__panel">
                <a class="button-primary mobile-menu__cta" href={navigation.donateHref}>
                  {uiCopy.support}
                </a>

                <nav aria-label="Mobile primary">
                  <ul class="mobile-menu__sections">
                    {
                      navigation.primaryItems.map((item) => (
                        <li>
                          {
                            item.children.length > 0 ? (
                              <details class="mobile-menu__group" data-group="mobile-subnav">
                                <summary class="mobile-menu__group-summary">
                                  <span class="mobile-menu__summary-copy">
                                    <span class="mobile-menu__summary-title">
                                      <span
                                        class="nav-disclosure__icon nav-disclosure__icon--item"
                                        set:html={getNavIcon(item.icon)}
                                      ></span>
                                      <span>{item.label}</span>
                                    </span>
                                    {item.description && (
                                      <span class="mobile-menu__summary-description">
                                        {item.description}
                                      </span>
                                    )}
                                  </span>
                                  <span class="nav-caret mobile-menu__caret" aria-hidden="true"></span>
                                </summary>
                                <div class="mobile-menu__group-body">
                                  <a
                                    class:list={[
                                      "mobile-menu__lead",
                                      isNavItemActive(slug, item.slug) && "mobile-menu__lead--active",
                                    ]}
                                    href={item.href}
                                  >
                                    <span
                                      class="nav-disclosure__icon"
                                      set:html={getNavIcon(item.icon)}
                                    ></span>
                                    <span class="mobile-menu__item-copy">
                                      <span>{uiCopy.browseItemPrefix} {item.label}</span>
                                      {item.description && <span>{item.description}</span>}
                                    </span>
                                  </a>
                                  {item.children.map((child) => (
                                    <a
                                      class="mobile-menu__item"
                                      href={child.href}
                                      aria-current={
                                        isNavItemActive(slug, child.slug) ? "page" : undefined
                                      }
                                    >
                                      <span
                                        class="nav-disclosure__icon nav-disclosure__icon--item"
                                        set:html={getNavIcon(child.icon)}
                                      ></span>
                                      <span class="mobile-menu__item-copy">
                                        <span>{child.label}</span>
                                        {child.description && <span>{child.description}</span>}
                                      </span>
                                    </a>
                                  ))}
                                </div>
                              </details>
                            ) : (
                              <a class="mobile-menu__single" href={item.href}>{item.label}</a>
                            )
                          }
                        </li>
                      ))
                    }
                  </ul>
                </nav>

                <div class="mobile-menu__languages">
                  <p>{uiCopy.languages}</p>
                  <div>
                    {
                      navigation.languageOptions.map((option) => (
                        <a href={option.href} aria-current={option.current ? "page" : undefined}>
                          <span
                            class:list={["locale-flag", getLocaleFlagClass(option.locale)]}
                            aria-hidden="true"
                          ></span>
                          <span>{option.code}</span>
                        </a>
                      ))
                    }
                  </div>
                </div>

                <div class="mobile-menu__legal">
                  {
                    navigation.utilityItems.map((item) => (
                      <a href={item.href}>{item.label}</a>
                    ))
                  }
                </div>
              </div>
            </details>
          </div>
        </div>
      </div>
    </header>

    <main class="shell content-shell">
      <slot />
    </main>

    {
      isHome && (
        <div class="footer-illustration">
          <img
            src="https://psychedelicare.eu/wp-content/uploads/2025/05/doctor-HD-cut-1024x1016-1-e1747987254443.jpg"
            alt="Medical illustration supporting PsychedeliCare"
            loading="lazy"
          />
        </div>
      )
    }

    <footer class="site-footer">
      <div class="shell site-footer__inner">
        <div class="site-footer__intro">
          <p class="site-footer__eyebrow">PsychedeliCare</p>
          <h2>{uiCopy.footerHeading}</h2>
          <p>{uiCopy.footerBody}</p>
          <a class="button-secondary" href={navigation.donateHref}>{uiCopy.supportCampaign}</a>
        </div>

        <div class="site-footer__nav">
          {
            navigation.footerItems.map((item) => (
              <section>
                <h3><a href={item.href}>{item.label}</a></h3>
                {
                  item.children.length > 0 && (
                    <ul>
                      {item.children.map((child) => <li><a href={child.href}>{child.label}</a></li>)}
                    </ul>
                  )
                }
              </section>
            ))
          }
        </div>
      </div>
    </footer>

    <script is:inline>
      (() => {
        const closingTimers = new WeakMap();
        const reduceMotionQuery = window.matchMedia("(prefers-reduced-motion: reduce)");

        const closeDetail = (detail, animated = false) => {
          if (!detail.open || detail.dataset.closing === "true") return;

          const shouldAnimate =
            animated &&
            !reduceMotionQuery.matches &&
            detail.classList.contains("nav-disclosure");

          if (!shouldAnimate) {
            detail.open = false;
            delete detail.dataset.closing;
            return;
          }

          detail.dataset.closing = "true";
          const timer = window.setTimeout(() => {
            detail.open = false;
            delete detail.dataset.closing;
            closingTimers.delete(detail);
          }, 190);
          closingTimers.set(detail, timer);
        };

        const openDetail = (detail) => {
          const timer = closingTimers.get(detail);
          if (timer) {
            window.clearTimeout(timer);
            closingTimers.delete(detail);
          }
          delete detail.dataset.closing;

          const group = detail.dataset.group;
          if (group) {
            document.querySelectorAll(`details[data-group="${group}"]`).forEach((other) => {
              if (other instanceof HTMLDetailsElement && other !== detail) {
                closeDetail(other, other.classList.contains("nav-disclosure"));
              }
            });
          }

          detail.open = true;
        };

        const scheduleClose = (detail) => {
          const existingTimer = closingTimers.get(detail);
          if (existingTimer) window.clearTimeout(existingTimer);

          const timer = window.setTimeout(() => {
            closeDetail(detail, true);
          }, 110);
          closingTimers.set(detail, timer);
        };

        document.querySelectorAll("details[data-hover-menu]").forEach((menu) => {
          if (!(menu instanceof HTMLDetailsElement)) return;

          const summary = menu.querySelector("summary");
          if (!summary) return;

          menu.addEventListener("mouseenter", () => {
            openDetail(menu);
          });

          menu.addEventListener("mouseleave", () => {
            scheduleClose(menu);
          });

          menu.addEventListener("focusin", () => openDetail(menu));
          menu.addEventListener("focusout", (event) => {
            if (!menu.contains(event.relatedTarget)) scheduleClose(menu);
          });

          summary.addEventListener("click", (event) => {
            event.preventDefault();
            if (menu.open && menu.dataset.closing !== "true") {
              closeDetail(menu, true);
            } else {
              openDetail(menu);
            }
          });

          menu.addEventListener("keydown", (event) => {
            if (event.key !== "Escape") return;
            closeDetail(menu, true);
            summary.focus();
          });
        });

        document.addEventListener("toggle", (event) => {
          const target = event.target;
          if (!(target instanceof HTMLDetailsElement) || !target.open) return;
          const group = target.dataset.group;
          if (!group) return;

          document.querySelectorAll(`details[data-group="${group}"]`).forEach((detail) => {
            if (detail instanceof HTMLDetailsElement && detail !== target) {
              closeDetail(detail, detail.classList.contains("nav-disclosure"));
            }
          });
        });

        document.addEventListener("pointerdown", (event) => {
          document.querySelectorAll('details[data-group="header-popover"][open]').forEach((detail) => {
            if (
              detail instanceof HTMLDetailsElement &&
              !detail.contains(event.target)
            ) {
              closeDetail(detail, detail.classList.contains("nav-disclosure"));
            }
          });
        });
      })();
    </script>
  </body>
</html>

<style is:global>
  :root {
    color-scheme: light;
    --bg: #ffffff;
    --bg-soft: #f7f9fc;
    --surface-strong: #ffffff;
    --border: rgba(29, 46, 86, 0.12);
    --border-strong: rgba(29, 46, 86, 0.22);
    --text: #131725;
    --muted: #4c5570;
    --link: #1f85b8;
    --link-hover: #166b94;
    --pink: #eb44d2;
    --purple: #a91ac0;
    --gradient: linear-gradient(90deg, #44b3eb 48%, #d729f2 87%);
    --gradient-heading: linear-gradient(30deg, #61b8ee 10%, #bf1dd1 60%);
    --gradient-footer: linear-gradient(232deg, #f41fd2 0%, #1dd6fa 81%);
    --shadow-soft: 0 24px 60px rgba(30, 47, 95, 0.08);
    --shadow-strong: 0 28px 80px rgba(30, 47, 95, 0.16);
    --body-size: 21px;
    font-family: "Jost", "Segoe UI", sans-serif;
    scroll-behavior: smooth;
  }

  * {
    box-sizing: border-box;
  }

  html,
  body {
    min-height: 100%;
    margin: 0;
    background: var(--bg);
  }

  body {
    color: var(--text);
    font-size: var(--body-size);
    line-height: 1.7;
    background:
      radial-gradient(circle at top left, rgba(68, 179, 235, 0.18), transparent 24rem),
      radial-gradient(circle at top right, rgba(235, 68, 210, 0.12), transparent 26rem),
      linear-gradient(180deg, #ffffff 0%, #fbfcff 36%, #ffffff 100%);
  }

  html {
    scroll-padding-top: 1.5rem;
  }

  img {
    max-width: 100%;
    height: auto;
    display: block;
  }

  a {
    color: var(--link);
    text-decoration-thickness: 0.08em;
    text-underline-offset: 0.12em;
    text-decoration-color: color-mix(in srgb, var(--link) 38%, transparent);
  }

  a:hover,
  a:focus-visible {
    color: var(--link-hover);
    text-decoration-color: color-mix(in srgb, var(--link-hover) 55%, transparent);
  }

  p,
  ul,
  ol,
  blockquote {
    margin: 0 0 1.05rem;
  }

  ul,
  ol {
    padding-left: 1.45rem;
  }

  h1,
  h2,
  h3,
  h4,
  h5,
  h6 {
    margin: 0 0 0.85rem;
    line-height: 1.04;
    font-family: "Jost", "Segoe UI", sans-serif;
    letter-spacing: -0.03em;
  }

  h1 {
    font-size: clamp(3rem, 8vw, 4.375rem);
    font-weight: 600;
  }

  h2 {
    margin-top: clamp(3rem, 8vw, 5.5rem);
    font-size: clamp(2.2rem, 6vw, 3.4375rem);
    font-weight: 600;
  }

  h3 {
    margin-top: 2rem;
    font-size: clamp(1.7rem, 4vw, 2.8125rem);
    font-weight: 800;
  }

  h4 {
    font-size: 1.2rem;
    margin-top: 1.4rem;
  }

  blockquote {
    padding: 1.2rem 1.35rem;
    border-left: 4px solid var(--pink);
    background: linear-gradient(180deg, rgba(235, 68, 210, 0.07), rgba(68, 179, 235, 0.08));
    border-radius: 1rem;
  }

  code {
    font-family:
      "SFMono-Regular", SFMono-Regular, Consolas, "Liberation Mono", Menlo,
      monospace;
  }

  .shell {
    width: min(1240px, calc(100vw - clamp(1.25rem, 4vw, 3.5rem)));
    margin: 0 auto;
  }

  .content-shell {
    padding: clamp(1.25rem, 2vw, 1.8rem) 0 clamp(4.5rem, 9vw, 7rem);
  }

  .site-header {
    position: relative;
    z-index: 30;
    padding-top: 0.85rem;
  }

  .site-header__bar {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    align-items: center;
    gap: 1.5rem;
    padding: 0.95rem 0;
  }

  .brand {
    display: flex;
    align-items: center;
    min-width: 0;
    text-decoration: none;
  }

  .brand__logo {
    width: min(16rem, 48vw);
    height: auto;
  }

  .site-nav--desktop {
    justify-self: center;
  }

  .site-nav__list {
    display: flex;
    align-items: center;
    gap: 1.4rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .site-nav__item,
  .language-switcher,
  .mobile-menu {
    position: relative;
  }

  .nav-link,
  .nav-summary,
  .site-footer__nav h3 a {
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    min-height: 2.5rem;
    padding: 0.2rem 0;
    border: 0;
    background: transparent;
    color: var(--text);
    font: inherit;
    font-size: 1rem;
    font-weight: 600;
    text-decoration: none;
    cursor: pointer;
    white-space: nowrap;
  }

  .nav-link::after,
  .nav-summary::after,
  .site-footer__nav h3 a::after {
    content: "";
    position: absolute;
    left: 0;
    right: 0;
    bottom: -0.25rem;
    height: 2px;
    border-radius: 999px;
    background: var(--gradient);
    transform: scaleX(0);
    transform-origin: center;
    transition: transform 180ms ease;
  }

  .nav-link:hover::after,
  .nav-link:focus-visible::after,
  .nav-summary:hover::after,
  .nav-summary:focus-visible::after,
  .site-footer__nav h3 a:hover::after,
  .site-footer__nav h3 a:focus-visible::after,
  .nav-link--active::after,
  .nav-summary--active::after {
    transform: scaleX(1);
  }

  .nav-caret {
    display: inline-block;
    flex: 0 0 auto;
    width: 0.55rem;
    height: 0.55rem;
    border-right: 2px solid currentColor;
    border-bottom: 2px solid currentColor;
    transform: translateY(-0.12rem) rotate(45deg);
    transform-origin: 50% 55%;
    transition: transform 180ms ease;
  }

  .nav-disclosure > summary::-webkit-details-marker,
  .language-switcher > summary::-webkit-details-marker,
  .mobile-menu > summary::-webkit-details-marker,
  .mobile-menu__group > summary::-webkit-details-marker {
    display: none;
  }

  .nav-disclosure[open] > .nav-summary .nav-caret,
  .language-switcher[open] > .locale-chip .nav-caret,
  .mobile-menu[open] > .mobile-menu__toggle .nav-caret {
    transform: translateY(0.12rem) rotate(225deg);
  }

  .nav-disclosure__panel,
  .language-switcher__panel,
  .mobile-menu__panel {
    border: 1px solid rgba(29, 46, 86, 0.09);
    border-radius: 1.1rem;
    background: rgba(255, 255, 255, 0.98);
    box-shadow: 0 22px 55px rgba(30, 47, 95, 0.12);
  }

  .nav-disclosure__panel,
  .language-switcher__panel {
    position: absolute;
    top: calc(100% + 1.5rem);
    right: 0;
  }

  .nav-disclosure__panel {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.7rem;
    width: min(46rem, calc(100vw - 3rem));
    padding: 0.8rem;
    left: 50%;
    right: auto;
    --menu-x: -50%;
    --menu-y: -0.45rem;
    opacity: 0;
    transform: translate(var(--menu-x), var(--menu-y)) scale(0.98);
    transform-origin: top center;
    transition:
