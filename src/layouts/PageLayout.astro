---
import { getUiCopy } from "../lib/uiCopy";
import type { PageEntry } from "../lib/content";
import BaseLayout from "./BaseLayout.astro";

type Props = {
  entry: PageEntry;
  headings?: { depth: number; slug: string; text: string }[];
  eyebrow?: string;
  teaser?: string;
};

function extractLeadParagraph(body: string) {
  const lines = body
    .split("\n")
    .map((line) => line.trim())
    .filter(Boolean);

  const collected: string[] = [];

  for (const line of lines) {
    if (
      line.startsWith("import ") ||
      line.startsWith("#") ||
      line.startsWith("<") ||
      line.startsWith("[") ||
      line.startsWith("- ")
    ) {
      if (collected.length > 0) {
        break;
      }

      continue;
    }

    collected.push(line);
  }

  return collected.join(" ").trim();
}

const {
  entry,
  headings = [],
  eyebrow,
  teaser,
} = Astro.props;

const title = entry.data.title;
const description = entry.data.description;
const locale = entry.data.locale;
const slug = entry.data.slug;
const intro = teaser ?? entry.data.teaser;
const isHome = entry.data.pageType === "home";
const hasRedundantIntro =
  entry.data.pageType === "section" || entry.data.pageType === "news-hub";
const firstContentHeading = headings.find((heading) => heading.depth === 2);
const heroTitle = isHome && headings[0]?.text ? headings[0].text : title;
const heroEyebrow = eyebrow ?? (isHome ? title : undefined);
const bodyLead = extractLeadParagraph(entry.body ?? "");
const introPrefixCandidates = [heroTitle, firstContentHeading?.text].filter(
  (value): value is string => Boolean(value),
);
let cleanedIntro = intro;

for (const prefix of introPrefixCandidates) {
  if (cleanedIntro?.toLowerCase().startsWith(prefix.toLowerCase())) {
    cleanedIntro = cleanedIntro.slice(prefix.length).trimStart();
    break;
  }
}

const completedHomeIntro = [bodyLead, cleanedIntro].find(
  (value) => value && /[.!?]$/.test(value.trim()),
);
const heroIntro = isHome ? completedHomeIntro : cleanedIntro;
const displayHeadings =
  hasRedundantIntro && firstContentHeading
    ? headings.filter((heading) => heading !== firstContentHeading)
    : headings;
const heroCtaLabel = isHome ? entry.data.heroCtaLabel : undefined;
const heroCtaHref = isHome ? entry.data.heroCtaHref : undefined;
const uiCopy = getUiCopy(locale);
---

<BaseLayout
  title={title}
  description={description}
  locale={locale}
  slug={slug}
  translationGroup={entry.data.translationGroup}
>
  <article
    class:list={[
      "page-layout",
      isHome && "page-layout--home",
      hasRedundantIntro && "page-layout--redundant-intro",
    ]}
  >
    <header class:list={["page-layout__hero", isHome && "page-layout__hero--home"]}>
      <div class="page-layout__hero-copy">
        {heroEyebrow && <p class="eyebrow">{heroEyebrow}</p>}
        <h1>{heroTitle}</h1>
        {heroIntro && <p class="page-layout__teaser">{heroIntro}</p>}
        {heroCtaLabel && heroCtaHref && (
          <a class="gradient-button page-layout__hero-cta" href={heroCtaHref}>
            {heroCtaLabel}
          </a>
        )}
      </div>
    </header>

    <div class="page-layout__body">
      {
        !isHome && displayHeadings.length > 0 && (
          <aside class="page-layout__toc">
            <p class="eyebrow">{uiCopy.onThisPage}</p>
            <ul>
              {displayHeadings.filter((heading) => heading.depth <= 3).map((heading) => (
                <li class={`depth-${heading.depth}`}>
                  <a href={`#${heading.slug}`}>{heading.text}</a>
                </li>
              ))}
            </ul>
          </aside>
        )
      }

      <div class="page-layout__content prose">
        <slot />
      </div>
    </div>
  </article>
</BaseLayout>

<style>
  .page-layout {
    display: grid;
    gap: clamp(1.4rem, 3vw, 2.3rem);
  }

  .page-layout__hero {
    display: grid;
    gap: clamp(1rem, 2vw, 1.35rem);
    padding: clamp(1.5rem, 4vw, 2.5rem) 0 clamp(1rem, 3vw, 1.5rem);
  }

  .page-layout--home {
    gap: clamp(1.8rem, 4vw, 3rem);
  }

  .page-layout__hero-copy {
    display: grid;
    gap: clamp(1rem, 2vw, 1.35rem);
    max-width: min(56rem, 100%);
  }

  .page-layout__hero h1 {
    max-width: 13ch;
    margin: 0;
    background-image: var(--gradient);
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
    color: transparent;
  }

  .page-layout__teaser {
    max-width: 48em;
    margin: 0;
    color: var(--muted);
    font-size: clamp(1.1rem, 1.3vw, 1.4rem);
  }

  .page-layout__hero--home {
    padding: clamp(2rem, 6vw, 5rem) 0 clamp(1.5rem, 4vw, 3rem);
  }

  .page-layout__hero-cta {
    justify-self: start;
    margin-top: 0.35rem;
  }

  .page-layout__body {
    display: grid;
    gap: clamp(1.4rem, 2vw, 2rem);
  }

  .page-layout__toc {
    padding: 0.35rem 0 0 1.15rem;
    border-left: 1px solid rgba(57, 30, 190, 0.14);
  }

  .page-layout--home .page-layout__body {
    grid-template-columns: 1fr;
  }

  .page-layout__toc ul {
    margin: 0;
    padding-left: 0;
    list-style: none;
  }

  .page-layout__toc li {
    margin: 0;
  }

  .page-layout__toc .depth-3 {
    margin-left: 0.8rem;
  }

  .page-layout__toc a {
    display: block;
    padding: 0.35rem 0;
    color: var(--muted);
    text-decoration: none;
  }

  .page-layout__toc a:hover,
  .page-layout__toc a:focus-visible {
    color: var(--link);
  }

  .page-layout__content {
    min-width: 0;
    padding: 0;
  }

  .page-layout--home .page-layout__content :global(h1:first-child) {
    display: none;
  }

  .page-layout--redundant-intro .page-layout__content :global(h2:first-of-type) {
    display: none;
  }

  .page-layout--redundant-intro
    .page-layout__content
    :global(h2:first-of-type + p) {
    display: none;
  }

  .page-layout__content :global(h2) {
    padding-top: clamp(1.4rem, 3vw, 2rem);
    border-top: 1px solid rgba(57, 30, 190, 0.12);
    scroll-margin-top: 1.5rem;
  }

  .page-layout__content :global(h2:first-child) {
    padding-top: 0;
    border-top: 0;
  }

  .page-layout__content :global(h3) {
    color: var(--text);
  }

  .page-layout__content :global(p),
  .page-layout__content :global(ul),
  .page-layout__content :global(ol),
  .page-layout__content :global(blockquote) {
    max-width: 34em;
  }

  .page-layout__content :global(ul),
  .page-layout__content :global(ol) {
    padding-left: 1.4rem;
  }

  .page-layout__content :global(hr) {
    border: 0;
    border-top: 1px solid var(--border);
    margin: 2rem 0;
  }

  .page-layout__content :global(.card-grid),
  .page-layout__content :global(.callout),
  .page-layout__content :global(.accordion),
  .page-layout__content :global(.news-list),
  .page-layout__content :global(.people-grid),
  .page-layout__content :global(.partner-grid) {
    max-width: none;
    margin-top: 1.75rem;
  }

  @media (min-width: 900px) {
    .page-layout__body {
      grid-template-columns: minmax(0, 1fr) 18.5rem;
      align-items: start;
    }

    .page-layout__content {
      grid-column: 1;
      grid-row: 1;
    }

    .page-layout__toc {
      position: sticky;
      top: 1.5rem;
      grid-column: 2;
      grid-row: 1;
    }
  }

  @media (max-width: 720px) {
    .page-layout__content {
      padding: 1.2rem;
      border-radius: 1.2rem;
    }
  }
</style>
