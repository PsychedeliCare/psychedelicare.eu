---
import { getUiCopy } from "../lib/uiCopy";
import type { PageEntry } from "../lib/content";
import BaseLayout from "./BaseLayout.astro";

type Props = {
  entry: PageEntry;
  headings?: { depth: number; slug: string; text: string }[];
  teaser?: string;
};

const {
  entry,
  headings = [],
  teaser,
} = Astro.props;

const title = entry.data.title;
const description = entry.data.description;
const locale = entry.data.locale;
const slug = entry.data.slug;
const intro = teaser ?? entry.data.teaser;
const isHome = entry.data.pageType === "home";
const firstContentHeading = headings.find((heading) => heading.depth === 2);
const heroTitle = isHome && headings[0]?.text ? headings[0].text : title;
const introPrefixCandidates = [heroTitle, firstContentHeading?.text].filter(
  (value): value is string => Boolean(value),
);
let cleanedIntro = intro;

for (const prefix of introPrefixCandidates) {
  if (cleanedIntro?.toLowerCase().startsWith(prefix.toLowerCase())) {
    cleanedIntro = cleanedIntro.slice(prefix.length).trimStart();
    break;
  }
}

const heroIntro = intro ?? cleanedIntro;
const heroCtaLabel = isHome ? entry.data.heroCtaLabel : undefined;
const heroCtaHref = isHome ? entry.data.heroCtaHref : undefined;
const uiCopy = getUiCopy(locale);
---

<BaseLayout
  title={title}
  description={description}
  locale={locale}
  slug={slug}
  translationGroup={entry.data.translationGroup}
>
  <article class:list={["page-layout", isHome && "page-layout--home"]}>
    {
      isHome && (
        <header class="page-layout__hero page-layout__hero--home">
          <img
            class="page-layout__hero-bg-logo"
            src="/assets/background-logo.svg"
            alt=""
            aria-hidden="true"
            loading="eager"
            decoding="async"
          />
          <div class="container px-4 page-layout__hero-inner">
            <div class="page-layout__hero-copy">
              <h1>{heroTitle}</h1>
              {heroIntro && <p class="page-layout__teaser">{heroIntro}</p>}
              {heroCtaLabel && heroCtaHref && (
                <a
                  class="page-layout__hero-cta page-layout__hero-cta--on-gradient"
                  href={heroCtaHref}
                >
                  {heroCtaLabel}
                </a>
              )}
            </div>
          </div>
        </header>
      )
    }

    <div class="container px-4">
      <div class="page-layout__body">
        {
          !isHome && headings.length > 0 && (
            <aside class="page-layout__toc" data-toc-scrollspy>
              <p class="eyebrow">{uiCopy.onThisPage}</p>
              <ul>
                {headings.filter((heading) => heading.depth <= 3).map((heading) => (
                  <li class={`depth-${heading.depth}`}>
                    <a href={`#${heading.slug}`}>{heading.text}</a>
                  </li>
                ))}
              </ul>
            </aside>
          )
        }

        <div class="page-layout__content prose">
          <slot />
        </div>
      </div>
    </div>
  </article>
</BaseLayout>

<script>
  import { augmentTocWithAccordions } from "../lib/accordionToc";
  import { initTocScrollspy } from "../lib/tocScrollspy";

  const toc = document.querySelector<HTMLElement>("[data-toc-scrollspy]");
  if (toc) {
    augmentTocWithAccordions(toc);
    initTocScrollspy(toc);
  }
</script>
