const { locale = "en" } = Astro.props;
const normalizedLocale = normalizeLocale(locale);
const copy = copyByLocale[normalizedLocale];
const dialogId = `icpr-event-dialog-${normalizedLocale}`;
const details = [
  {
    icon: IconMapPin,
    label: copy.details.where,
    value: copy.values.where,
  },
  {
    icon: IconDoorEnter,
    label: copy.details.access,
    value: copy.values.access,
  },
  {
    icon: IconWritingSign,
    label: copy.details.signup,
    value: copy.values.signup,
  },
  {
    icon: IconArmchair,
    label: copy.details.capacity,
    value: copy.values.capacity,
  },
];
---

{
  isVisible && (
    <>
      <aside class="icpr-top-banner" aria-label={copy.ariaLabel}>
        <div class="container px-4 icpr-top-banner__inner">
          <button
            type="button"
            class="icpr-top-banner__trigger"
            data-icpr-open={dialogId}
            aria-haspopup="dialog"
            aria-controls={dialogId}
          >
            <span class="icpr-top-banner__line">
              <strong class="icpr-top-banner__heading">{copy.heading}</strong>
              <span class="icpr-top-banner__sep" aria-hidden="true">·</span>
              <span class="icpr-top-banner__meta">{copy.bannerMeta}</span>
            </span>
            <span class="icpr-top-banner__cta">{copy.detailsLabel}</span>
          </button>
        </div>
      </aside>

      <dialog
        class="icpr-event-dialog"
        id={dialogId}
        aria-labelledby={`${dialogId}-title`}
      >
        <form method="dialog" class="grid gap-0">
          <div class="icpr-event-dialog__header">
            <h2 class="icpr-event-dialog__title" id={`${dialogId}-title`}>
              {copy.title}
            </h2>
            <button
              type="submit"
              class="button-secondary shrink-0 min-h-10 px-4 py-2 text-[0.95rem]"
              aria-label={copy.closeLabel}
            >
              {copy.closeLabel}
            </button>
          </div>

          <div class="icpr-event-dialog__body">
            <article class="icpr-event" aria-label={copy.ariaLabel}>
              <p class="icpr-event__eyebrow icpr-event__eyebrow--dialog">{copy.eyebrow}</p>

              <div class="icpr-event__body icpr-event__body--dialog">
                <div class="icpr-event__main">
                  <p class="icpr-event__collab">{copy.collaboration}</p>
                  <p class="icpr-event__description">{copy.description}</p>
                  <p class="icpr-event__links">
                    <a href={mapsUrl} rel="noopener noreferrer" target="_blank">
                      {copy.mapsLabel}
                      <span class="icpr-event__ext" set:html={IconExternalLink} aria-hidden="true" />
                    </a>
                    <span class="icpr-event__links-sep" aria-hidden="true">
                      ·
                    </span>
                    <a href={eventUrl} rel="noopener noreferrer" target="_blank">
                      {copy.programmeLabel}
                      <span class="icpr-event__ext" set:html={IconExternalLink} aria-hidden="true" />
                    </a>
                  </p>
                </div>

                <ul class="icpr-event__details">
                  {details.map((item) => (
                    <li class="icpr-event__detail">
                      <span class="icpr-event__icon" set:html={item.icon} aria-hidden="true" />
                      <span class="icpr-event__detail-text">
                        <strong class="icpr-event__detail-label">{item.label}</strong>
                        <span class="icpr-event__detail-value">{item.value}</span>
                      </span>
                    </li>
                  ))}
                </ul>
              </div>
            </article>
          </div>
        </form>
      </dialog>
    </>
  )
}

<script>
  function initIcprEventDialogs() {
    document.querySelectorAll<HTMLButtonElement>("[data-icpr-open]").forEach((button) => {
      if (button.dataset.icprBound === "true") {
        return;
      }

      button.dataset.icprBound = "true";
      const dialogId = button.getAttribute("data-icpr-open");
      const dialog = dialogId ? document.getElementById(dialogId) : null;

      button.addEventListener("click", () => {
        if (dialog instanceof HTMLDialogElement) {
          dialog.showModal();
        }
      });
    });

    document.querySelectorAll<HTMLDialogElement>(".icpr-event-dialog").forEach((dialog) => {
      if (dialog.dataset.icprBackdropBound === "true") {
        return;
      }

      dialog.dataset.icprBackdropBound = "true";
      dialog.addEventListener("click", (event) => {
        if (event.target === dialog) {
          dialog.close();
        }
      });
    });
  }

  initIcprEventDialogs();
  document.addEventListener("astro:page-load", initIcprEventDialogs);
</script>
