---
import type { ScaffoldPage } from "../data/pageScaffolds";

type Props = {
  page: ScaffoldPage;
};

const { page } = Astro.props;
---

<article class="py-12 pb-20">
  <header
    class="p-[clamp(1.5rem,4vw,3rem)] my-8 border border-border rounded-[2rem] shadow-soft bg-gradient-to-b from-surface-strong to-white/72"
  >
    <p class="eyebrow m-0">Content scaffold</p>
    <h1 class="mt-[0.4rem] mb-0 leading-[1.1] text-[clamp(2.4rem,5vw,4.8rem)]">{page.title}</h1>
    <p class="max-w-[62ch] mt-4 mb-0 text-muted text-[1.1rem]">{page.summary}</p>

    <div class="flex flex-wrap gap-3 mt-6">
      <span class="inline-flex items-center py-[0.4rem] px-[0.8rem] border border-border rounded-full bg-bg-soft text-[0.94rem]">
        Route: {page.slug === "" ? "/" : `/${page.slug}/`}
      </span>
      {page.status && (
        <span class="inline-flex items-center py-[0.4rem] px-[0.8rem] border border-border rounded-full bg-bg-soft text-[0.94rem]">
          Status: {page.status}
        </span>
      )}
      {page.purpose && (
        <span class="inline-flex items-center py-[0.4rem] px-[0.8rem] border border-border rounded-full bg-bg-soft text-[0.94rem]">
          Purpose: {page.purpose}
        </span>
      )}
      {
        page.existingContent && (
          <a
            class="inline-flex items-center py-[0.4rem] px-[0.8rem] border border-border rounded-full bg-bg-soft text-[0.94rem] no-underline"
            href={page.existingContent}
            target="_blank"
            rel="noreferrer"
          >
            Existing content reference
          </a>
        )
      }
    </div>
  </header>

  {
    page.children && page.children.length > 0 && (
      <section class="p-[clamp(1.2rem,2vw,1.6rem)] border border-border rounded-3xl bg-bg-soft shadow-soft">
        <div class="grid gap-[0.35rem] mb-3">
          <p class="eyebrow m-0">Child pages</p>
          <h2 class="m-0 leading-[1.1] text-[clamp(1.45rem,2vw,2rem)]">Subpages in this section</h2>
        </div>

        <ul class="grid gap-[0.7rem] pl-[1.2rem] mt-4 mb-0">
          {page.children.map((child) => (
            <li>
              <a class="text-link" href={`/${child.slug}/`}>{child.title}</a>
            </li>
          ))}
        </ul>
      </section>
    )
  }

  <section class="grid gap-5">
    {page.sections.map((section) => (
      <section
        class="p-[clamp(1.2rem,2vw,1.6rem)] border border-border rounded-3xl bg-bg-soft shadow-soft"
        id={section.title.toLowerCase().replaceAll(/[^a-z0-9]+/g, "-")}
      >
        <div class="grid gap-[0.35rem] mb-3">
          <p class="eyebrow m-0">Section scaffold</p>
          <h2 class="m-0 leading-[1.1] text-[clamp(1.45rem,2vw,2rem)]">{section.title}</h2>
        </div>

        {(section.status || section.purpose || section.blockType) && (
          <div class="flex flex-wrap gap-3 mt-4">
            {section.status && (
              <span class="inline-flex items-center py-[0.4rem] px-[0.8rem] border border-border rounded-full bg-white text-[0.94rem]">
                Status: {section.status}
              </span>
            )}
            {section.purpose && (
              <span class="inline-flex items-center py-[0.4rem] px-[0.8rem] border border-border rounded-full bg-white text-[0.94rem]">
                Purpose: {section.purpose}
              </span>
            )}
            {section.blockType && (
              <span class="inline-flex items-center py-[0.4rem] px-[0.8rem] border border-border rounded-full bg-white text-[0.94rem]">
                Style: {section.blockType}
              </span>
            )}
          </div>
        )}

        {section.content?.map((paragraph) => <p class="mt-[0.8rem] mb-0">{paragraph}</p>)}

        {section.existingContent && (
          <p class="mt-[0.8rem] mb-0">
            Existing content: <a href={section.existingContent}>{section.existingContent}</a>
          </p>
        )}

        {section.links && section.links.length > 0 && (
          <ul class="grid gap-[0.7rem] pl-[1.2rem] mt-4 mb-0">
            {section.links.map((link) => (
              <li>
                <a class="text-link" href={link.url}>{link.label}</a>
              </li>
            ))}
          </ul>
        )}
      </section>
    ))}
  </section>
</article>
