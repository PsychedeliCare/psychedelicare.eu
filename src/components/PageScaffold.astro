---
import type { ScaffoldPage } from "../data/pageScaffolds";

type Props = {
  page: ScaffoldPage;
};

const { page } = Astro.props;
---

<article class="page">
  <header class="hero">
    <p class="eyebrow">Content scaffold</p>
    <h1>{page.title}</h1>
    <p class="summary">{page.summary}</p>

    <div class="meta">
      <span class="chip">Route: {page.slug === "" ? "/" : `/${page.slug}/`}</span>
      {page.status && <span class="chip">Status: {page.status}</span>}
      {page.purpose && <span class="chip">Purpose: {page.purpose}</span>}
      {
        page.existingContent && (
          <a class="chip chip--link" href={page.existingContent} target="_blank" rel="noreferrer">
            Existing content reference
          </a>
        )
      }
    </div>
  </header>

  {
    page.children && page.children.length > 0 && (
      <section class="panel">
        <div class="panel__header">
          <p class="eyebrow">Child pages</p>
          <h2>Subpages in this section</h2>
        </div>

        <ul class="child-list">
          {page.children.map((child) => <li><a href={`/${child.slug}/`}>{child.title}</a></li>)}
        </ul>
      </section>
    )
  }

  <section class="sections">
    {page.sections.map((section) => (
      <section class="panel" id={section.title.toLowerCase().replaceAll(/[^a-z0-9]+/g, "-")}>
        <div class="panel__header">
          <p class="eyebrow">Section scaffold</p>
          <h2>{section.title}</h2>
        </div>

        {(section.status || section.purpose || section.blockType) && (
          <div class="meta meta--section">
            {section.status && <span class="chip">Status: {section.status}</span>}
            {section.purpose && <span class="chip">Purpose: {section.purpose}</span>}
            {section.blockType && <span class="chip">Style: {section.blockType}</span>}
          </div>
        )}

        {section.content?.map((paragraph) => <p>{paragraph}</p>)}

        {section.existingContent && (
          <p>
            Existing content: <a href={section.existingContent}>{section.existingContent}</a>
          </p>
        )}

        {section.links && section.links.length > 0 && (
          <ul class="link-list">
            {section.links.map((link) => <li><a href={link.url}>{link.label}</a></li>)}
          </ul>
        )}
      </section>
    ))}
  </section>
</article>

<style>
  .page {
    padding: 3rem 0 5rem;
  }

  .hero {
    padding: clamp(1.5rem, 4vw, 3rem);
    margin: 2rem 0;
    border: 1px solid var(--border);
    border-radius: 2rem;
    background: linear-gradient(180deg, var(--surface-strong), rgba(255, 255, 255, 0.72));
    box-shadow: var(--shadow);
  }

  .eyebrow {
    margin: 0;
    color: var(--accent);
    font-size: 0.84rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  h1,
  h2 {
    margin: 0;
    line-height: 1.1;
  }

  h1 {
    margin-top: 0.4rem;
    font-size: clamp(2.4rem, 5vw, 4.8rem);
  }

  h2 {
    font-size: clamp(1.45rem, 2vw, 2rem);
  }

  .summary {
    max-width: 62ch;
    margin: 1rem 0 0;
    color: var(--muted);
    font-size: 1.1rem;
  }

  .meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 1.5rem;
  }

  .meta--section {
    margin-top: 1rem;
  }

  .chip {
    display: inline-flex;
    align-items: center;
    padding: 0.4rem 0.8rem;
    border: 1px solid var(--border);
    border-radius: 999px;
    background: var(--surface);
    font-size: 0.94rem;
  }

  .chip--link {
    text-decoration: none;
  }

  .sections {
    display: grid;
    gap: 1.25rem;
  }

  .panel {
    padding: clamp(1.2rem, 2vw, 1.6rem);
    border: 1px solid var(--border);
    border-radius: 1.5rem;
    background: var(--surface);
    box-shadow: var(--shadow);
  }

  .panel__header {
    display: grid;
    gap: 0.35rem;
    margin-bottom: 0.75rem;
  }

  .panel p {
    margin: 0.8rem 0 0;
  }

  .child-list,
  .link-list {
    display: grid;
    gap: 0.7rem;
    padding-left: 1.2rem;
    margin: 1rem 0 0;
  }

  .child-list a,
  .link-list a {
    color: var(--accent);
  }
</style>
