---
type Card = {
  title: string;
  description?: string;
  href?: string;
  meta?: string;
};

type Props = {
  cards: Card[];
};

const { cards } = Astro.props;
---

<div class="card-grid">
  {
    cards.map((card) => {
      const Tag = card.href ? "a" : "div";

      return (
        <Tag class:list={["card", card.href && "card--link"]} href={card.href}>
          {card.meta && <p class="card__meta">{card.meta}</p>}
          <h3>{card.title}</h3>
          {card.description && <p>{card.description}</p>}
        </Tag>
      );
    })
  }
</div>

<style>
  .card-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(15rem, 1fr));
    gap: 1rem;
  }

  .card {
    display: grid;
    gap: 0.75rem;
    padding: 1.1rem;
    border: 1px solid var(--border);
    border-radius: 1rem;
    background: var(--surface);
    text-decoration: none;
    color: inherit;
  }

  .card--link:hover,
  .card--link:focus-visible {
    background: var(--surface-strong);
    outline: 2px solid var(--accent-soft);
    outline-offset: 2px;
  }

  .card__meta {
    margin: 0;
    color: var(--muted);
    font-size: 0.9rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  h3,
  p {
    margin: 0;
  }
</style>
