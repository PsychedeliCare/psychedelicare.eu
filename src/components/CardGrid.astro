---
import facebookIcon from "@tabler/icons/outline/brand-facebook.svg?raw";
import instagramIcon from "@tabler/icons/outline/brand-instagram.svg?raw";
import linkedInIcon from "@tabler/icons/outline/brand-linkedin.svg?raw";
import xIcon from "@tabler/icons/outline/brand-x.svg?raw";
import youtubeIcon from "@tabler/icons/outline/brand-youtube.svg?raw";

type Card = {
  title: string;
  description?: string;
  href?: string;
  meta?: string;
};

type Props = {
  cards: Card[];
};

const { cards } = Astro.props;

const socialIcons: Record<string, string> = {
  facebook: facebookIcon,
  instagram: instagramIcon,
  linkedin: linkedInIcon,
  x: xIcon,
  youtube: youtubeIcon,
};

const getSocialIcon = (title: string) => socialIcons[title.toLowerCase()] ?? null;
---

<div class="card-grid">
  {
    cards.map((card) => {
      const Tag = card.href ? "a" : "div";
      const socialIcon = getSocialIcon(card.title);

      return (
        <Tag class:list={["card", card.href && "card--link"]} href={card.href}>
          {card.meta && <p class="card__meta">{card.meta}</p>}
          <h3 class:list={[socialIcon && "card__title--with-icon"]}>
            {socialIcon && <span class="card__icon" set:html={socialIcon} aria-hidden="true" />}
            <span>{card.title}</span>
          </h3>
          {card.description && <p>{card.description}</p>}
        </Tag>
      );
    })
  }
</div>

<style>
  .card-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(16rem, 1fr));
    gap: 0.9rem 1.4rem;
  }

  .card {
    display: grid;
    align-content: start;
    gap: 0.5rem;
    min-height: 100%;
    padding: 0 0 1rem;
    border-bottom: 1px solid var(--border);
    text-decoration: none;
    color: inherit;
    transition:
      transform 220ms cubic-bezier(0.22, 1, 0.36, 1),
      border-color 220ms ease;
  }

  .card--link:hover,
  .card--link:focus-visible {
    border-color: rgba(215, 41, 242, 0.24);
    outline: none;
    transform: translateY(-1px);
  }

  .card__meta {
    margin: 0;
    color: var(--purple);
    font-size: 0.82rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }

  .card h3,
  .card p {
    margin: 0;
  }

  .card h3 {
    font-size: clamp(1.4rem, 2vw, 1.9rem);
    color: var(--text);
  }

  .card__title--with-icon {
    display: flex;
    align-items: center;
    gap: 0.65rem;
  }

  .card__icon {
    display: inline-flex;
    flex: 0 0 auto;
    color: var(--purple);
  }

  .card__icon :global(svg) {
    width: 1.15em;
    height: 1.15em;
    stroke-width: 1.8;
  }

  .card p {
    color: var(--muted);
  }
</style>
