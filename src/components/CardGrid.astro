---
type Card = {
  title: string;
  description?: string;
  href?: string;
  meta?: string;
};

type Props = {
  cards: Card[];
};

const { cards } = Astro.props;
---

<div class="card-grid">
  {
    cards.map((card) => {
      const Tag = card.href ? "a" : "div";

      return (
        <Tag class:list={["card", card.href && "card--link"]} href={card.href}>
          {card.meta && <p class="card__meta">{card.meta}</p>}
          <h3>{card.title}</h3>
          {card.description && <p>{card.description}</p>}
        </Tag>
      );
    })
  }
</div>

<style>
  .card-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(16rem, 1fr));
    gap: 0.9rem 1.4rem;
  }

  .card {
    display: grid;
    align-content: start;
    gap: 0.5rem;
    min-height: 100%;
    padding: 0 0 1rem;
    border-bottom: 1px solid var(--border);
    text-decoration: none;
    color: inherit;
    transition:
      transform 220ms cubic-bezier(0.22, 1, 0.36, 1),
      border-color 220ms ease;
  }

  .card--link:hover,
  .card--link:focus-visible {
    border-color: rgba(215, 41, 242, 0.24);
    outline: none;
    transform: translateY(-1px);
  }

  .card__meta {
    margin: 0;
    color: var(--purple);
    font-size: 0.82rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }

  .card h3,
  .card p {
    margin: 0;
  }

  .card h3 {
    font-size: clamp(1.4rem, 2vw, 1.9rem);
    color: var(--text);
  }

  .card p {
    color: var(--muted);
  }
</style>
