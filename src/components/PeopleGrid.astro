---
import { getCountryFlagClasses } from "../lib/countryFlags";

type PersonCard = {
  name: string;
  role?: string;
  location?: string;
  email?: string;
  website?: string;
  image?: string;
  bio?: string;
};

type Props = {
  title?: string;
  id?: string;
  people: PersonCard[];
};

const { title, id, people } = Astro.props;
---

<section class="people-grid grid gap-[1.4rem] my-10" id={id}>
  {title && <h2 class="m-0">{title}</h2>}

  <div class="grid gap-[1.2rem] grid-cols-[repeat(auto-fit,minmax(260px,1fr))] items-start">
    {
      people.map((person) => (
        <article class="grid gap-4 grid-rows-[auto_1fr] pb-[1.2rem] border-b border-border">
          {person.image && (
            <div class="aspect-square overflow-hidden rounded-[0.9rem] bg-[rgba(68,179,235,0.08)] leading-none">
              <img
                class="w-full h-full block object-cover object-[center_top]"
                src={person.image}
                alt=""
                loading="lazy"
              />
            </div>
          )}

          <div class="grid gap-[0.6rem] content-start">
            <h3 class="m-0">{person.name}</h3>
            {person.role && <p class="m-0 font-bold text-purple">{person.role}</p>}
            {person.location && (
              <p class="flex items-center gap-[0.45rem] m-0 text-muted">
                {getCountryFlagClasses(person.location).map((flagClass) => (
                  <span
                    class={`w-[1.15em] h-[0.85em] shrink-0 rounded-[2px] shadow-[0_0_0_1px_rgba(15,23,42,0.08)] ${flagClass}`}
                    aria-hidden="true"
                  />
                ))}
                <span>{person.location}</span>
              </p>
            )}
            {person.bio && <p class="m-0">{person.bio}</p>}

            <div class="flex flex-wrap gap-3">
              {person.email && (
                <a class="no-underline font-semibold" href={`mailto:${person.email}`}>
                  {person.email}
                </a>
              )}
              {person.website && (
                <a class="no-underline font-semibold" href={person.website} target="_blank" rel="noreferrer">
                  Website
                </a>
              )}
            </div>
          </div>
        </article>
      ))
    }
  </div>
</section>
