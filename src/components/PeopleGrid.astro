---
import { getCountryFlagClasses } from "../lib/countryFlags";

type PersonCard = {
  name: string;
  role?: string;
  location?: string;
  email?: string;
  website?: string;
  image?: string;
  bio?: string;
};

type Props = {
  title?: string;
  people: PersonCard[];
};

const { title, people } = Astro.props;
---

<section class="people-grid">
  {title && <h2>{title}</h2>}

  <div class="people-grid__items">
    {
      people.map((person) => (
        <article class="person-card">
          {person.image && (
            <div class="person-card__media">
              <img src={person.image} alt="" loading="lazy" />
            </div>
          )}

          <div class="person-card__body">
            <h3>{person.name}</h3>
            {person.role && <p class="person-card__role">{person.role}</p>}
            {person.location && (
              <p class="person-card__meta">
                {getCountryFlagClasses(person.location).map((flagClass) => (
                  <span class={`person-card__flag ${flagClass}`} aria-hidden="true" />
                ))}
                <span>{person.location}</span>
              </p>
            )}
            {person.bio && <p>{person.bio}</p>}

            <div class="person-card__links">
              {person.email && <a href={`mailto:${person.email}`}>{person.email}</a>}
              {person.website && (
                <a href={person.website} target="_blank" rel="noreferrer">
                  Website
                </a>
              )}
            </div>
          </div>
        </article>
      ))
    }
  </div>
</section>

<style>
  .people-grid {
    display: grid;
    gap: 1.4rem;
    margin-block: 2.5rem;
  }

  .people-grid h2 {
    margin: 0;
  }

  .people-grid__items {
    display: grid;
    gap: 1.2rem;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    align-items: start;
  }

  .person-card {
    display: grid;
    gap: 1rem;
    grid-template-rows: auto 1fr;
    padding: 0 0 1.2rem;
    border-bottom: 1px solid var(--border);
  }

  .person-card__media {
    aspect-ratio: 1;
    overflow: hidden;
    border-radius: 0.9rem;
    background: rgba(68, 179, 235, 0.08);
    line-height: 0;
  }

  .person-card__media img {
    width: 100%;
    height: 100%;
    display: block;
    object-fit: cover;
    object-position: center top;
  }

  .person-card__body {
    display: grid;
    gap: 0.6rem;
    align-content: start;
  }

  .person-card__body h3,
  .person-card__body p {
    margin: 0;
  }

  .person-card__role {
    font-weight: 700;
    color: var(--purple);
  }

  .person-card__meta {
    display: flex;
    align-items: center;
    gap: 0.45rem;
    color: var(--muted);
  }

  .person-card__flag {
    width: 1.15em;
    height: 0.85em;
    flex-shrink: 0;
    border-radius: 2px;
    box-shadow: 0 0 0 1px rgba(15, 23, 42, 0.08);
  }

  .person-card__links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  .person-card__links a {
    text-decoration: none;
    font-weight: 600;
  }
</style>
