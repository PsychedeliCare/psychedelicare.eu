---
type PersonCard = {
  name: string;
  role?: string;
  location?: string;
  email?: string;
  website?: string;
  image?: string;
  bio?: string;
};

type Props = {
  title?: string;
  people: PersonCard[];
};

const { title, people } = Astro.props;
---

<section class="people-grid">
  {title && <h2>{title}</h2>}

  <div class="people-grid__items">
    {
      people.map((person) => (
        <article class="person-card">
          {person.image && (
            <div class="person-card__media">
              <img src={person.image} alt="" loading="lazy" />
            </div>
          )}

          <div class="person-card__body">
            <h3>{person.name}</h3>
            {person.role && <p class="person-card__role">{person.role}</p>}
            {person.location && <p class="person-card__meta">{person.location}</p>}
            {person.bio && <p>{person.bio}</p>}

            <div class="person-card__links">
              {person.email && <a href={`mailto:${person.email}`}>{person.email}</a>}
              {person.website && (
                <a href={person.website} target="_blank" rel="noreferrer">
                  Website
                </a>
              )}
            </div>
          </div>
        </article>
      ))
    }
  </div>
</section>

<style>
  .people-grid {
    display: grid;
    gap: 1.25rem;
    margin-block: 2rem;
  }

  .people-grid h2 {
    margin: 0;
  }

  .people-grid__items {
    display: grid;
    gap: 1rem;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
  }

  .person-card {
    display: grid;
    gap: 1rem;
    padding: 1rem;
    border: 1px solid var(--border);
    border-radius: 1rem;
    background: var(--surface);
  }

  .person-card__media img {
    width: 100%;
    aspect-ratio: 1;
    object-fit: cover;
    border-radius: 0.8rem;
    background: rgba(0, 0, 0, 0.05);
  }

  .person-card__body {
    display: grid;
    gap: 0.55rem;
  }

  .person-card__body h3,
  .person-card__body p {
    margin: 0;
  }

  .person-card__role {
    font-weight: 700;
    color: var(--accent);
  }

  .person-card__meta {
    color: var(--muted);
  }

  .person-card__links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }
</style>
