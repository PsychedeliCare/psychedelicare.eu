---
import { getCountryFlagClasses } from "../lib/countryFlags";

type PersonCard = {
  name: string;
  role?: string;
  location?: string;
  email?: string;
  website?: string;
  image?: string;
  bio?: string;
};

type Props = {
  title?: string;
  id?: string;
  people: PersonCard[];
  variant?: "grid" | "rows";
  websiteLabel?: string;
};

const { title, id, people, variant = "grid", websiteLabel = "Website" } = Astro.props;
const isRows = variant === "rows";
---

<section class:list={["people-grid grid gap-[1.4rem] my-10", isRows && "people-grid--rows"]} id={id}>
  {title && <h2 class="m-0">{title}</h2>}

  <div
    class:list={[
      "grid items-start",
      isRows
        ? "gap-y-[1.75rem] gap-x-[2.4rem] grid-cols-1 lg:grid-cols-2"
        : "gap-y-[1.2rem] gap-x-[2.4rem] grid-cols-[repeat(auto-fit,minmax(260px,1fr))]",
    ]}
  >
    {
      people.map((person) => (
        <article
          class:list={[
            "grid pb-[1.2rem] border-b border-border",
            isRows
              ? "gap-x-[2rem] gap-y-4 grid-cols-1 md:grid-cols-[minmax(0,1fr)_minmax(0,3fr)] items-start"
              : "gap-4 grid-rows-[auto_1fr]",
          ]}
        >
          {person.image && (
            <div class="people-grid__photo aspect-square overflow-hidden rounded-[0.9rem] bg-[rgba(68,179,235,0.08)] leading-none">
              <img
                class="w-full h-full block object-cover object-[center_top]"
                src={person.image}
                alt=""
                loading="lazy"
              />
            </div>
          )}

          <div class="grid gap-[0.6rem] content-start">
            <h3 class="m-0">{person.name}</h3>
            {person.role && <p class="m-0 font-bold text-purple">{person.role}</p>}
            {person.location && (
              <p class="flex items-center gap-[0.45rem] m-0 text-muted">
                {getCountryFlagClasses(person.location).map((flagClass) => (
                  <span
                    class={`w-[1.15em] h-[0.85em] shrink-0 rounded-[2px] shadow-[0_0_0_1px_rgba(15,23,42,0.08)] ${flagClass}`}
                    aria-hidden="true"
                  />
                ))}
                <span>{person.location}</span>
              </p>
            )}
            {person.bio && <p class="m-0">{person.bio}</p>}

            <div class="flex flex-wrap gap-3">
              {person.email && (
                <a class="no-underline font-semibold" href={`mailto:${person.email}`}>
                  {person.email}
                </a>
              )}
              {person.website && (
                <a class="no-underline font-semibold" href={person.website} target="_blank" rel="noreferrer">
                  {websiteLabel}
                </a>
              )}
            </div>
          </div>
        </article>
      ))
    }
  </div>
</section>
