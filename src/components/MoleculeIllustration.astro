---
type Props = {
  src: string;
  alt: string;
};

const { src, alt } = Astro.props;
---

<figure class="molecule-illustration m-0 mb-4 max-w-none md:float-left md:clear-left md:mt-[0.15rem] md:mr-[1.35rem] md:mb-3">
  <div
    class="flex items-center justify-center w-[min(100%,11.5rem)] aspect-square p-4 rounded-2xl shadow-soft"
    style="background: radial-gradient(circle at 20% 15%, rgba(97, 184, 238, 0.28), transparent 55%), radial-gradient(circle at 85% 80%, rgba(191, 29, 209, 0.22), transparent 50%), linear-gradient(145deg, #1a0f5c 0%, #2a1490 52%, #391ebe 100%);"
  >
    <img class="w-full h-full object-contain block" src={src} alt={alt} loading="lazy" decoding="async" />
  </div>
</figure>
