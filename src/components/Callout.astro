---
type Props = {
  title: string;
  body?: string;
  href?: string;
  label?: string;
  tone?: "default" | "accent";
};

const {
  title,
  body,
  href,
  label = "Learn more",
  tone = "default",
} = Astro.props;
---

<aside
  class:list={[
    "callout grid gap-5 py-[clamp(1.4rem,3vw,2rem)] px-[clamp(1.4rem,3vw,2rem)]",
    tone === "accent"
      ? "border-y-0 bg-gradient-to-br from-white/16 to-white/[0.06] [background-image:linear-gradient(135deg,rgba(255,255,255,0.16),rgba(255,255,255,0.06)),var(--background-image-gradient)]"
      : "border-y border-[rgba(57,30,190,0.16)] bg-gradient-to-b from-[rgba(68,179,235,0.05)] to-transparent",
  ]}
>
  <div>
    <h2
      class:list={[
        "m-0 mb-[0.6rem] text-[clamp(1.8rem,3vw,2.5rem)]",
        tone === "accent" && "text-white bg-none",
      ]}
    >
      {title}
    </h2>
    {body && (
      <p class:list={["m-0", tone === "accent" ? "text-white" : "text-muted"]}>
        {body}
      </p>
    )}
  </div>
  {href && (
    <a
      class="justify-self-start inline-flex items-center min-h-[3.2rem] py-[0.8rem] px-[1.2rem] rounded-full border border-border bg-white no-underline text-[1.1rem] font-bold text-pink transition-[transform,box-shadow] duration-200 ease-[cubic-bezier(0.22,1,0.36,1)] hover:-translate-y-0.5 hover:shadow-[0_18px_36px_rgba(255,255,255,0.22)] focus-visible:-translate-y-0.5 focus-visible:shadow-[0_18px_36px_rgba(255,255,255,0.22)] focus-visible:outline-none"
      href={href}
    >
      {label}
    </a>
  )}
</aside>
