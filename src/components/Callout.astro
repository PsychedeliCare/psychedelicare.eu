---
type Props = {
  title: string;
  body?: string;
  href?: string;
  label?: string;
  tone?: "default" | "accent";
};

const {
  title,
  body,
  href,
  label = "Learn more",
  tone = "default",
} = Astro.props;
---

<aside class:list={["callout", tone === "accent" && "callout--accent"]}>
  <div class="callout__copy">
    <h2>{title}</h2>
    {body && <p>{body}</p>}
  </div>
  {href && (
    <a class="callout__link" href={href}>
      {label}
    </a>
  )}
</aside>

<style>
  .callout {
    display: grid;
    gap: 1.25rem;
    padding: clamp(1.4rem, 3vw, 2rem);
    border-top: 1px solid rgba(57, 30, 190, 0.16);
    border-bottom: 1px solid rgba(57, 30, 190, 0.16);
    background:
      linear-gradient(180deg, rgba(68, 179, 235, 0.05), rgba(255, 255, 255, 0));
  }

  .callout--accent {
    border-top-color: transparent;
    border-bottom-color: transparent;
    background:
      linear-gradient(135deg, rgba(255, 255, 255, 0.16), rgba(255, 255, 255, 0.06)),
      var(--gradient);
  }

  .callout__copy h2 {
    margin: 0 0 0.6rem;
    font-size: clamp(1.8rem, 3vw, 2.5rem);
  }

  .callout__copy p {
    margin: 0;
    color: var(--muted);
  }

  .callout--accent .callout__copy h2,
  .callout--accent .callout__copy p {
    color: #ffffff;
    background: none;
  }

  .callout__link {
    justify-self: start;
    display: inline-flex;
    align-items: center;
    min-height: 3.2rem;
    padding: 0.8rem 1.2rem;
    border-radius: 1rem;
    border: 1px solid var(--border);
    background: #fff;
    text-decoration: none;
    font-size: 1.1rem;
    font-weight: 700;
    color: var(--pink);
    transition:
      transform 200ms cubic-bezier(0.22, 1, 0.36, 1),
      box-shadow 200ms ease;
  }

  .callout__link:hover,
  .callout__link:focus-visible {
    transform: translateY(-2px);
    box-shadow: 0 18px 36px rgba(255, 255, 255, 0.22);
    outline: none;
  }
</style>
