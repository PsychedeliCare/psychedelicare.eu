---
import type { PageEntry } from "../lib/content";
import { localizePath } from "../lib/i18n";

type Props = {
  entries: PageEntry[];
};

const { entries } = Astro.props;
---

{
  entries.length > 0 && (
    <ul class="news-list grid gap-4 list-none p-0 m-0">
      {entries.map((entry) => (
        <li class="pb-[1.2rem] border-b border-border">
          <p class="flex flex-wrap gap-[0.8rem] m-0 mb-[0.8rem] text-[0.92rem] font-semibold text-muted">
            {entry.data.publishedAt && (
              <time
                class="inline-flex items-center py-[0.15rem] px-[0.55rem] rounded-full bg-[rgba(68,179,235,0.08)]"
                datetime={entry.data.publishedAt}
              >
                {new Date(entry.data.publishedAt).toLocaleDateString(entry.data.locale, {
                  year: "numeric",
                  month: "long",
                  day: "numeric",
                })}
              </time>
            )}
            {entry.data.category && (
              <span class="inline-flex items-center py-[0.15rem] px-[0.55rem] rounded-full bg-[rgba(68,179,235,0.08)]">
                {entry.data.category}
              </span>
            )}
          </p>
          <h3 class="m-0 text-[clamp(1.5rem,2vw,1.9rem)]">
            <a
              class="no-underline text-text hover:text-link focus-visible:text-link"
              href={localizePath(entry.data.locale, entry.data.slug)}
            >
              {entry.data.title}
            </a>
          </h3>
          {entry.data.teaser && (
            <p class="mt-[0.8rem] mb-0 text-muted">{entry.data.teaser}</p>
          )}
        </li>
      ))}
    </ul>
  )
}
