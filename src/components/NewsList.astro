---
import type { PageEntry } from "../lib/content";
import { localizePath } from "../lib/i18n";

type Props = {
  entries: PageEntry[];
};

const { entries } = Astro.props;
---

{
  entries.length > 0 && (
    <ul class="news-list">
      {entries.map((entry) => (
        <li class="news-card">
          <p class="news-card__meta">
            {entry.data.publishedAt && (
              <time datetime={entry.data.publishedAt}>
                {new Date(entry.data.publishedAt).toLocaleDateString(entry.data.locale, {
                  year: "numeric",
                  month: "long",
                  day: "numeric",
                })}
              </time>
            )}
            {entry.data.category && <span>{entry.data.category}</span>}
          </p>
          <h3>
            <a href={localizePath(entry.data.locale, entry.data.slug)}>{entry.data.title}</a>
          </h3>
          {entry.data.teaser && <p>{entry.data.teaser}</p>}
        </li>
      ))}
    </ul>
  )
}

<style>
  .news-list {
    display: grid;
    gap: 1rem;
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .news-card {
    padding: 0 0 1.2rem;
    border-bottom: 1px solid var(--border);
  }

  .news-card__meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.8rem;
    margin: 0 0 0.8rem;
    font-size: 0.92rem;
    font-weight: 600;
    color: var(--muted);
  }

  .news-card__meta span,
  .news-card__meta time {
    display: inline-flex;
    align-items: center;
    padding: 0.15rem 0.55rem;
    border-radius: 999px;
    background: rgba(68, 179, 235, 0.08);
  }

  .news-card h3 {
    margin: 0;
    font-size: clamp(1.5rem, 2vw, 1.9rem);
  }

  .news-card p:last-child {
    margin: 0.8rem 0 0;
    color: var(--muted);
  }

  .news-card a {
    text-decoration: none;
    color: var(--text);
  }

  .news-card a:hover,
  .news-card a:focus-visible {
    color: var(--link);
  }
 </style>
