---
type AccordionItem = {
  question: string;
  answer: string;
};

type Props = {
  items: AccordionItem[];
};

const { items } = Astro.props;
---

{
  items.length > 0 && (
    <div class="accordion grid gap-0">
      {items.map((item) => (
        <details class="border-t border-border overflow-hidden last:border-b last:border-border">
          <summary class="cursor-pointer flex items-center justify-between gap-4 py-[1.15rem] px-[1.2rem] font-bold list-none [&::-webkit-details-marker]:hidden after:content-['+'] after:shrink-0 after:text-[1.6rem] after:leading-none after:text-pink after:transition-transform after:duration-200 open:after:rotate-45">
            {item.question}
          </summary>
          <div
            class="px-[1.2rem] pb-[1.15rem] text-muted [&_p:first-child]:mt-0"
            set:html={item.answer}
          />
        </details>
      ))}
    </div>
  )
}
