---
type AccordionItem = {
  question: string;
  answer: string;
};

type Props = {
  items: AccordionItem[];
};

const { items } = Astro.props;
---

{
  items.length > 0 && (
    <div class="accordion">
      {items.map((item) => (
        <details class="accordion__item">
          <summary>{item.question}</summary>
          <div class="accordion__content" set:html={item.answer} />
        </details>
      ))}
    </div>
  )
}

<style>
  .accordion {
    display: grid;
    gap: 0.85rem;
  }

  .accordion__item {
    border: 1px solid var(--border);
    border-radius: 1rem;
    background: var(--surface);
    overflow: hidden;
  }

  .accordion__item summary {
    cursor: pointer;
    padding: 1rem 1.1rem;
    font-weight: 700;
    list-style: none;
  }

  .accordion__item summary::-webkit-details-marker {
    display: none;
  }

  .accordion__content {
    padding: 0 1.1rem 1rem;
    color: var(--muted);
  }

  .accordion__content :global(p:first-child) {
    margin-top: 0;
  }
 </style>
